{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-markdown.sh\"",
            "timeout": 120,
            "statusMessage": "doc-checks"
          }
        ]
      }
    ]
  }
}
